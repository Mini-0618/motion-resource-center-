          "typical_scale": [
            1.3,
            1
          ],
          "duration_s": [
            1.5,
            3
          ],
          "scale_interpolation": "log"
        },
        "editorial_start": {
          "scale": [
            1.3,
            1
          ],
          "duration_s": 2.2,
          "tilt_deg": [
            0,
            0
          ],
          "drift_px": [
            0,
            0
          ]
        }
      },
      "house_example": "从花谱已有标注拉回整页，页外附馆藏名与年代。局部所写金额的含义须从史料核对。",
      "original_direction_zh": "先停在需要辨认的细节，读完再沿同一锚点拉回整页，让出处与细节在终点同时可见。",
      "failure_mode": "商品宣传片常用斜角和景深；在档案页上容易遮掉上下文或夸大低分辨率扫描的细节。",
      "acceptance_on_future_render": "在起点、中段、终点核对锚点与可读性。相机透视设于父层，原页以自身像素坐标定位。",
      "source_cases": [
        "https://motionvideo.xyz/videos/jake11moran-3041df",
        "https://motionvideo.xyz/videos/rossaxbt-94583b",
        "https://motionvideo.xyz/videos/gdgtify-efbc09"
      ]
    },
    {
      "id": "motionvideo/match-cut",
      "name": "保持视觉锚点的硬切",
      "family": "transitions",
      "status": "candidate",
      "render_tested": false,
      "production_approved": false,
      "type": "method",
      "source": "https://motionvideo.xyz/moves/transitions/match-cut",
      "existing_components": [
        "match-cut",
        "JYS-261126-07-03"
      ],
      "purpose": "让观众比较两个对象共享的形状，同时看见身份、时间或功能的变化。",
      "parameters": {
        "public_move": {
          "transition_frames": 0
        },
        "registry_default": {
          "duration_s": 4,
          "fps": 30,
          "hard_cut_s": 1.4,
          "cut_frame_zero_based": 42,
          "inputs": [
            "accent",
            "label_a",
            "label_b"
          ]
        }
      },
      "house_example": "同一页的总览与局部可对准一朵花切换；跨档案、跨年代时在切点明示两边身份与日期。",
      "original_direction_zh": "找出两镜中足够醒目的同一轮廓，把圆心和尺寸对齐，在动作尚未停下时切换。两侧分别保留出处。",
      "failure_mode": "把十七世纪花谱无标识地接到现代币价，容易让观众把相似形状理解成同一历史事件。",
      "acceptance_on_future_render": "比较切点前一帧和后一帧的轮廓、比例与运动方向；另请观看者复述两张图的关系。",
      "source_cases": [
        "https://motionvideo.xyz/videos/higgsfield_ai-edddb9",
        "https://motionvideo.xyz/videos/raphaelaubryy-b20885"
      ]
    }
  ]
