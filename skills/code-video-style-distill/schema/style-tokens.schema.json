{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "code-video-style-distill/style-tokens.schema.json",
  "title": "Style tokens (风格底座) for code-generated motion videos",
  "description": "Produced by scripts/distill.py, consumed by template/ (Remotion). Every block carries provenance in fidelity_notes: measured | inferred | default | manual.",
  "type": "object",
  "required": [
    "name",
    "version",
    "canvas",
    "palette",
    "typography",
    "layout",
    "motion",
    "rhythm",
    "components",
    "fidelity_notes",
    "provenance"
  ],
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "bezier": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "family": {
      "type": "object",
      "required": [
        "css"
      ],
      "properties": {
        "css": {
          "type": "string",
          "description": "CSS font-family stack actually used by the template"
        },
        "vibe": {
          "type": "string"
        },
        "free_substitutes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "license_note": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "integer"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "video": {
          "type": "string"
        },
        "analysis_dir": {
          "type": "string"
        },
        "distilled_at": {
          "type": "string"
        },
        "duration_s": {
          "type": "number"
        }
      }
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 16
        },
        "height": {
          "type": "integer",
          "minimum": 16
        },
        "fps": {
          "type": "number",
          "minimum": 1
        },
        "aspect": {
          "type": "string"
        }
      }
    },
    "palette": {
      "type": "object",
      "required": [
        "bg",
        "surface",
        "primary",
        "accent",
        "text",
        "text_muted"
      ],
      "properties": {
        "bg": {
          "$ref": "#/$defs/hex"
        },
        "surface": {
          "$ref": "#/$defs/hex"
        },
        "primary": {
          "$ref": "#/$defs/hex"
        },
        "accent": {
          "$ref": "#/$defs/hex"
        },
        "text": {
          "$ref": "#/$defs/hex"
        },
        "text_muted": {
          "$ref": "#/$defs/hex"
        },
        "code_text": {
          "$ref": "#/$defs/hex"
        },
        "extra": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hex"
          }
        },
        "gradient": {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/hex"
            },
            "to": {
              "$ref": "#/$defs/hex"
            },
            "angle": {
              "type": "number"
            }
          }
        },
        "measured_swatches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hex": {
                "$ref": "#/$defs/hex"
              },
              "ratio": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "typography": {
      "type": "object",
      "required": [
        "families",
        "scale_px",
        "weights"
      ],
      "properties": {
        "vibe": {
          "type": "string"
        },
        "families": {
          "type": "object",
          "required": [
            "display",
            "body",
            "mono"
          ],
          "properties": {
            "display": {
              "$ref": "#/$defs/family"
            },
            "body": {
              "$ref": "#/$defs/family"
            },
            "mono": {
              "$ref": "#/$defs/family"
            }
          }
        },
        "scale_px": {
          "type": "object",
          "required": [
            "display",
            "h1",
            "h2",
            "body",
            "caption",
            "code"
          ],
          "additionalProperties": {
            "type": "number"
          }
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "letter_spacing_em": {
          "type": "number"
        },
        "line_height": {
          "type": "number"
        },
        "font_substitutions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "original_font",
              "substitute"
            ],
            "properties": {
              "role": {
                "type": "string"
              },
              "observed_vibe": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "original_font": {
                "type": "string"
              },
              "substitute": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "alternatives": {
                "type": "array"
              },
              "size_px": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "adjust": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "margins_pct",
        "alignment"
      ],
      "properties": {
        "margins_pct": {
          "type": "object",
          "required": [
            "left",
            "right",
            "top",
            "bottom"
          ],
          "additionalProperties": {
            "type": "number"
          }
        },
        "safe_area_pct": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "grid": {
          "type": "object",
          "properties": {
            "columns": {
              "type": "integer"
            },
            "gutter_pct": {
              "type": "number"
            },
            "fit_ratio": {
              "type": "number"
            }
          }
        },
        "alignment": {
          "enum": [
            "left",
            "center",
            "mixed"
          ]
        },
        "radius_px": {
          "type": "number"
        },
        "decor": {
          "type": "object",
          "properties": {
            "grid_lines": {
              "type": "boolean"
            },
            "glow": {
              "type": "boolean"
            },
            "noise": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "required": [
        "durations_s",
        "easing",
        "enter_style",
        "stagger_s",
        "transition"
      ],
      "properties": {
        "durations_s": {
          "type": "object",
          "required": [
            "fast",
            "base",
            "slow"
          ],
          "additionalProperties": {
            "type": "number"
          }
        },
        "easing": {
          "type": "object",
          "required": [
            "enter"
          ],
          "properties": {
            "family_guess": {
              "type": "string"
            },
            "enter": {
              "type": "object",
              "properties": {
                "cubic_bezier": {
                  "$ref": "#/$defs/bezier"
                }
              }
            },
            "exit": {
              "type": "object",
              "properties": {
                "cubic_bezier": {
                  "$ref": "#/$defs/bezier"
                }
              }
            },
            "emphasis": {
              "type": "object",
              "properties": {
                "cubic_bezier": {
                  "$ref": "#/$defs/bezier"
                }
              }
            }
          }
        },
        "spring": {
          "type": "object",
          "properties": {
            "damping": {
              "type": "number"
            },
            "stiffness": {
              "type": "number"
            },
            "mass": {
              "type": "number"
            }
          }
        },
        "enter_style": {
          "enum": [
            "slide-up",
            "slide-left",
            "fade",
            "scale",
            "spring-pop"
          ]
        },
        "title_enter_style": {
          "enum": [
            "slide-up",
            "slide-left",
            "fade",
            "scale",
            "spring-pop"
          ]
        },
        "exit_style": {
          "type": "string"
        },
        "enter_distance_px": {
          "type": "number"
        },
        "stagger_s": {
          "type": "number"
        },
        "transition": {
          "type": "object",
          "required": [
            "type",
            "duration_s"
          ],
          "properties": {
            "type": {
              "enum": [
                "wipe",
                "fade",
                "slide",
                "zoom",
                "cut"
              ]
            },
            "duration_s": {
              "type": "number"
            }
          }
        },
        "typing_cps": {
          "type": "number"
        },
        "easings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "keyframes": {
          "type": "object"
        }
      }
    },
    "rhythm": {
      "type": "object",
      "properties": {
        "shot_mean_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "shot_median_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "motion_onset_interval_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "visual_bpm": {
          "type": [
            "number",
            "null"
          ]
        },
        "audio_bpm": {
          "type": [
            "number",
            "null"
          ]
        },
        "av_sync": {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string"
            },
            "match_ratio": {
              "type": [
                "number",
                "null"
              ]
            },
            "median_offset_ms": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "pacing_rule": {
          "type": "string"
        },
        "entrance_events_per_min": {
          "type": [
            "number",
            "null"
          ],
          "description": "入场事件密度：非转场运动事件数 / 时长(分钟)"
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "confidence"
        ],
        "properties": {
          "type": {
            "enum": [
              "title_card",
              "bullet_list",
              "bar_chart",
              "number_counter",
              "code_block",
              "keyword_highlight",
              "subtitle_bar",
              "progress_bar",
              "transition",
              "evidence_frame",
              "timeline",
              "compare_columns",
              "flow_chart",
              "other"
            ]
          },
          "template_segment": {
            "type": [
              "string",
              "null"
            ],
            "description": "script.json segment type that reproduces it"
          },
          "scenes": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "evidence": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "taxonomy": {
            "type": "object",
            "properties": {
              "ui": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "video": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source": {
                "type": "string"
              }
            }
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    "components_style": {
      "type": "object",
      "description": "Per-component style. Values come from detection in the reference (provenance components_style.<k> = seen) or default mapping from palette/motion/layout (unknown). Template defaults: template/src/theme.ts compStyle().",
      "properties": {
        "progress_bar": {
          "type": "boolean"
        },
        "subtitle": {
          "type": "object"
        },
        "evidence": {
          "type": "object",
          "required": [
            "frame_color",
            "highlight_color",
            "enter_s"
          ],
          "properties": {
            "frame_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "frame_stroke_px": {
              "type": "number",
              "minimum": 0
            },
            "radius_px": {
              "type": "number",
              "minimum": 0
            },
            "highlight_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "highlight_stroke_px": {
              "type": "number",
              "minimum": 0
            },
            "source_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "zoom_scale": {
              "type": "number",
              "minimum": 1,
              "maximum": 2
            },
            "enter_s": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "highlight_delay_s": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "measured": {
              "type": "object"
            }
          }
        },
        "timeline": {
          "type": "object",
          "required": [
            "line_color",
            "node_color",
            "node_size_px",
            "enter_stagger_s"
          ],
          "properties": {
            "line_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "line_px": {
              "type": "number",
              "minimum": 0
            },
            "node_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "node_size_px": {
              "type": "number",
              "minimum": 0
            },
            "date_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "label_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "enter_stagger_s": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "enter_s": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "measured": {
              "type": "object"
            }
          }
        },
        "compare": {
          "type": "object",
          "required": [
            "panel_fill",
            "gap_pct",
            "highlight_color",
            "enter_stagger_s"
          ],
          "properties": {
            "panel_fill": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "panel_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "title_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "gap_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "radius_px": {
              "type": "number",
              "minimum": 0
            },
            "highlight_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "enter_stagger_s": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "enter_s": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "measured": {
              "type": "object"
            }
          }
        },
        "flow": {
          "type": "object",
          "required": [
            "node_fill",
            "node_stroke",
            "arrow_color",
            "step_s"
          ],
          "properties": {
            "node_fill": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "node_stroke": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "node_stroke_px": {
              "type": "number",
              "minimum": 0
            },
            "node_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "radius_px": {
              "type": "number",
              "minimum": 0
            },
            "arrow_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "arrow_px": {
              "type": "number",
              "minimum": 0
            },
            "step_s": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "enter_s": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "orientation": {
              "enum": [
                "horizontal",
                "vertical"
              ]
            },
            "measured": {
              "type": "object"
            }
          }
        }
      }
    },
    "fidelity_notes": {
      "type": "object",
      "required": [
        "measured",
        "inferred"
      ],
      "properties": {
        "measured": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inferred": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaults": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "needs_visual_review": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manual_overrides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_pixel_identical_because": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "token path -> {status, confidence, evidence[], method, note}. status rule adapted from aicodeking/leanrea (MIT): seen | inferred | unknown (unknown = not measured, NOT absent). evidence/confidence shape inspired by obaid1dev/dea (MIT).",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "confidence"
        ],
        "properties": {
          "status": {
            "enum": [
              "seen",
              "inferred",
              "unknown"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array"
          },
          "method": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  }
}